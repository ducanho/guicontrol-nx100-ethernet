{
  "robot_ip": "192.168.255.1",
  "robot_port": 80,
  "timeout_seconds": 3,
  "poll_interval_ms": 1000,
  "auto_send_delay_ms": 400,
  "move_timeout_seconds": 60,
  "tolerance": {"xyz_mm": 1.0, "angle_deg": 0.5},
  "speed": {
    "movl": {"min": 0.1, "max": 100, "default": 5, "step": 0.1, "unit": "mm/s"},
