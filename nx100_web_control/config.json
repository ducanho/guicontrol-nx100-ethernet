    "y": {"min": -2000, "max": 2000, "step": 0.001, "nudge": 1, "unit": "mm"},
    "z": {"min": -500, "max": 2500, "step": 0.001, "nudge": 1, "unit": "mm"},
    "rx": {"min": -180, "max": 180, "step": 0.01, "nudge": 0.1, "unit": "deg"},
    "ry": {"min": -180, "max": 180, "step": 0.01, "nudge": 0.1, "unit": "deg"},
    "rz": {"min": -180, "max": 180, "step": 0.01, "nudge": 0.1, "unit": "deg"}
  },
  "joint": {
    "s": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"},
    "l": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"},
    "u": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"},
    "r": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"},
    "b": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"},
    "t": {"min": -100000, "max": 100000, "step": 1, "nudge": 100, "unit": "pulse"}
  }
}
